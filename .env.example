EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
EXPO_PUBLIC_EAS_PROJECT_ID=032dd368-6eae-4a70-bbe5-4ccef2fc06cb
EXPO_PUBLIC_GITHUB_REPO_URL=https://github.com/Selftend/selftend
EXPO_PUBLIC_PUBLIC_APP_URL=
EXPO_PUBLIC_SUPPORT_EMAIL=
EXPO_PUBLIC_PRIVACY_EMAIL=
EXPO_PUBLIC_SECURITY_EMAIL=
EXPO_PUBLIC_WEB_PUSH_VAPID_PUBLIC_KEY=
# Optional: Sentry crash/error reporting DSN. Leave empty to disable monitoring
# entirely (default for contributors and local development).
EXPO_PUBLIC_SENTRY_DSN=
# Play Store URL shown on web surfaces and used by the update banner / Android
# download bar. Leave unset for Selftend's own listing. Self-hosters: set your
# own listing URL, or set it to an empty string - your fork is not on ours.
# Empty means no store button, no download bar, and no native update offer (the
# web reload banner still works; it is origin-relative).
# EXPO_PUBLIC_PLAY_STORE_URL=
# App Store URL shown on web surfaces. Leave unset for Selftend's own listing;
# set your own, or an empty string to drop the iOS button.
# EXPO_PUBLIC_APP_STORE_URL=
# Discord invite URL. Leave unset for the default community server; set to an empty string to hide all Discord UI.
EXPO_PUBLIC_DISCORD_URL=
# GitHub Sponsors URL for the app's Donate row and nothing else. Leave unset for the maintainer's page; set to an empty string to hide the row.
EXPO_PUBLIC_SPONSORS_URL=
# Subreddit URL. Leave unset for the default r/Selftend; set to an empty string to hide the Reddit link.
EXPO_PUBLIC_REDDIT_URL=
# YouTube channel URL. Leave unset for the default @Selftend channel; set to an empty string to hide the YouTube link.
EXPO_PUBLIC_YOUTUBE_URL=
