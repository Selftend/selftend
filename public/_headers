/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self' https://*.supabase.co https://accounts.google.com; img-src 'self' data: https://*.supabase.co https://*.googleusercontent.com; font-src 'self'; frame-src https://accounts.google.com https://*.supabase.co; worker-src 'self'; manifest-src 'self'; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload

# Content-hashed build output. Expo's web export fingerprints these filenames
# with an MD5 of their contents, so a changed file is always a changed URL and
# these can never go stale: fonts/images land under /assets/, the entry bundle
# and CSS under /_expo/static/. Both paths need listing - /assets/* does not
# cover /_expo/static/*, and without the second rule the entry bundle and the
# stylesheet fall through to Cloudflare's default max-age=0, must-revalidate
# and cost a revalidation round-trip on every single page load.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/_expo/static/*
  Cache-Control: public, max-age=31536000, immutable

# No rule for the HTML shell on purpose. /index.html is never served - it 307s
# to / - and a rule on / would only cover the root, not the SPA fallback that
# serves the same shell for every client route (/journal, /settings/..., ...).
# All of those already come back as max-age=0, must-revalidate, which is what
# the shell wants, so a partial rule here would only be misleading.

/selftend-push-worker.js
  Cache-Control: no-cache

# The update surface's version document (#388): must never be cached stale or
# the "new version available" offer lags a whole cache lifetime behind.
/version.json
  Cache-Control: no-cache

/manifest.webmanifest
  Content-Type: application/manifest+json
