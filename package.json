{
  "name": "selftend",
  "main": "index.ts",
  "version": "0.13.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "node --env-file=.env.local scripts/start-dev-client.js",
    "start:prod": "node --env-file=.env scripts/start-dev-client.js --hide-env-local",
    "start:emulator": "node --env-file=.env.local scripts/android-dev.js",
    "start:prod:emulator": "node --env-file=.env scripts/android-dev.js --hide-env-local",
    "build:android:development": "npm exec eas-cli -- build --platform android --profile development",
    "build:android:development:local": "node scripts/build-android-dev-local.js",
    "build:android:preview": "npm exec eas-cli -- build --platform android --profile preview",
    "build:android:production": "npm exec eas-cli -- build --platform android --profile production",
    "build:android:production:local": "node --env-file=.env scripts/build-android-prod-local.js",
    "submit:android:closed": "npm exec eas-cli -- submit --platform android --profile closed",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "export:web": "npm exec expo -- export --platform web --clear",
    "serve:web:production": "npm exec expo -- serve",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:integration": "jest -c jest.integration.config.js --runInBand",
    "test:e2e": "playwright test",
    "test:e2e:local": "node scripts/e2e-local.js",
    "test:coverage": "jest --coverage --runInBand",
    "coverage:ratchet": "node scripts/check-coverage-ratchet.js",
    "coverage:ratchet:update": "node scripts/check-coverage-ratchet.js --update",
    "verify": "npm run lint && npm run format:check && npm run typecheck && npm run test:coverage && npm run coverage:ratchet",
    "db:start": "npm exec supabase -- start",
    "db:stop": "npm exec supabase -- stop",
    "db:reset": "node scripts/db-reset.js",
    "db:status": "npm exec supabase -- status",
    "db:push:prod": "npm exec supabase -- db push --linked",
    "analytics:onboarding": "node scripts/analytics-report.js onboarding",
    "analytics:engagement": "node scripts/analytics-report.js engagement",
    "prepare": "husky",
    "android": "expo run:android",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@expo-google-fonts/noto-sans": "^0.4.2",
    "@expo-google-fonts/nunito": "^0.4.2",
    "@expo/vector-icons": "^15.0.3",
    "@hookform/resolvers": "^5.2.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "@rn-primitives/avatar": "^1.4.0",
    "@rn-primitives/checkbox": "^1.4.0",
    "@rn-primitives/label": "^1.4.0",
    "@rn-primitives/popover": "^1.4.0",
    "@rn-primitives/portal": "^1.4.0",
    "@rn-primitives/slot": "^1.4.0",
    "@rn-primitives/switch": "^1.4.0",
    "@sentry/react-native": "~8.19.0",
    "@supabase/supabase-js": "^2.103.2",
    "@tanstack/query-async-storage-persister": "^5.101.2",
    "@tanstack/react-query": "^5.99.0",
    "@tanstack/react-query-persist-client": "^5.101.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.20",
    "expo": "^57.0.0",
    "expo-apple-authentication": "~57.0.1",
    "expo-asset": "~57.0.6",
    "expo-audio": "~57.0.2",
    "expo-constants": "~57.0.6",
    "expo-dev-client": "~57.0.7",
    "expo-font": "~57.0.1",
    "expo-image-manipulator": "~57.0.5",
    "expo-image-picker": "~57.0.5",
    "expo-linear-gradient": "~57.0.1",
    "expo-linking": "~57.0.3",
    "expo-local-authentication": "~57.0.1",
    "expo-localization": "~57.0.1",
    "expo-network": "~57.0.1",
    "expo-notifications": "~57.0.6",
    "expo-router": "~57.0.7",
    "expo-secure-store": "~57.0.1",
    "expo-splash-screen": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.1",
    "expo-web-browser": "~57.0.1",
    "i18next": "^26.0.8",
    "nativewind": "^4.2.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-easy-crop": "^5.5.7",
    "react-hook-form": "^7.72.1",
    "react-i18next": "^17.0.6",
    "react-native": "0.86.0",
    "react-native-android-widget": "^0.20.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.25.2",
    "react-native-sortables": "^1.9.4",
    "react-native-svg": "15.15.4",
    "react-native-ui-datepicker": "^3.3.0",
    "react-native-url-polyfill": "^3.0.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.0",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^3.4.19",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^4.3.6",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@playwright/test": "1.59.1",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.10",
    "babel-preset-expo": "~57.0.3",
    "eslint": "^10.7.0",
    "eslint-config-expo": "~57.0.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "jest-expo": "~57.0.2",
    "lint-staged": "^17.0.2",
    "patch-package": "^8.0.1",
    "prettier": "^3.8.3",
    "qrcode-terminal": "^0.12.0",
    "react-test-renderer": "19.2.3",
    "typescript": "~6.0.3"
  },
  "expo": {
    "install": {
      "exclude": [
        "@sentry/react-native"
      ]
    }
  },
  "overrides": {
    "react-native-windows": "0.83.2",
    "shell-quote": "1.9.0",
    "form-data": "4.0.6",
    "postcss": "^8.5.10",
    "undici": "6.27.0",
    "@xmldom/xmldom": "0.8.13",
    "tar": "7.5.19",
    "@tootallnate/once": "2.0.1",
    "@babel/core": "7.29.7",
    "uuid": "11.1.1",
    "brace-expansion@5": "5.0.9",
    "js-yaml@3": "3.15.0",
    "js-yaml@4": "4.3.0",
    "ws@6": "6.2.4",
    "ws@7": "7.5.11",
    "ws@8": "8.21.0",
    "eslint": "^10.7.0"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix --no-warn-ignored",
      "prettier --write",
      "jest --findRelatedTests --bail --passWithNoTests"
    ],
    "*.{json,md,yml,yaml,css}": [
      "prettier --write"
    ]
  }
}
